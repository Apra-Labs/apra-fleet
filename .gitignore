node_modules/
dist/
data/

# apra-fleet-se's package-local vendored schema snapshot (apra-fleet-bun):
# build artifact written by packages/apra-fleet-se/scripts/vendor-schemas.mjs,
# not a checked-in fixture (contrast with test/fixtures/vendor-apra-pm-schemas/).
packages/apra-fleet-se/vendor/schemas/
.fleet-task.md
*.js.map
*.tsbuildinfo
.env
tests/integration/email-test-config.json
examples/workflows/email-notify/config.json
*.pem
fleet.config.json
~/.claude-fleet/
materials/*
.claude/settings.local.json

# CLAUDE.md is already tracked (git add -f was used), so this entry only prevents
# new untracked CLAUDE.md files from being accidentally staged -- it does not untrack the existing file.
CLAUDE.md

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/

# .claude/settings.json is already tracked (git add -f was used, apra-fleet-tm7.12)
# -- content is machine-independent (the bd prime SessionStart hook plus
# deploy.md's permission prefixes) and `bd setup claude`/`bd init` merge into
# it idempotently rather than overwrite it, so tracking does not leave a
# clone with a permanently dirty working tree (verified: re-running `bd
# setup claude` against the tracked content is byte-for-byte a no-op, and
# `apra-fleet install`'s own settings write targets the user's HOME
# .claude/settings.json, never this project-local one). This entry only
# prevents a new local settings.json variant from being accidentally staged
# over the tracked one -- it does not untrack the existing file.
.claude/settings.json

# E2E test fixtures (local only, never commit)
.e2e-fixtures/

# sprint-logs/ holds durable per-branch sprint-cost artifacts that the sprint
# workflow explicitly commits (apra-fleet-tm7.13; see
# packages/apra-fleet-se/apra-pm/docs/sprint-workflow.md's "committed to the
# branch" and packages/apra-fleet-se/apra-pm/skills/pm/cost.md's "Commit it."
# instructions for calibration.json) -- so *.jsonl, *.analysis.md, and
# calibration.json are intentionally NOT ignored here (an earlier version of
# this rule ignored *.jsonl/*.analysis.md too, which silently fought that
# documented, still-current commit practice). Only the per-run STATE SNAPSHOT
# bin/cli.mjs writes on every sprint exit (sprint-logs/sprint_*.json, any
# depth -- see packages/apra-fleet-se/bin/cli.mjs's stateSnapshotDir/
# stateSnapshotPrefix) is genuine scratch and stays ignored below.
**/sprint-logs/sprint_*.json

# Provider agent context files are tracked project deliverables (git add -f was used).
# These entries prevent sprint-injected replacements from being accidentally staged.
GEMINI.md
AGENTS.md
COPILOT-INSTRUCTIONS.md

# local compose_permissions ledger artifact
/permissions.json

# Beads / Dolt files (added by bd init)
.beads/proxieddb/

# Local tool scaffolding, not project deliverables
.agents/
.codex/

# Auto-sprint scaffold logs left in repo root (not under sprint-logs/)
/auto-sprint-*.log
/auto-sprint-*.err.log

# Fleet-sprint orchestrator run artifacts left in repo root
/fleet-sprint-eft-*.log*

# Per-run sprint scaffold (handoff docs and run logs)
/HANDOFF-*.md
/sprint-*.log

# Fleet log dumps (e.g. .fleet-log-win-excerpt.txt) -- local debug artifacts, never commit
.fleet-log-*

# Fleet orchestrator review and plan scaffold outputs -- per-round reviewer/planner scratch, never commit
.fleet-review-output.json
.fleet-review-verdict*.json
.fleet-plan-review-output.json

# Per-file integration-test progress state (scripts/run-integ-suites.mjs)
/integ-suite-status.json
/integ-suite-status.json.tmp
/integ-suite-heartbeat.json
/integ-suite-run.log

# apra-fleet-tm7.13: the blanket top-level '/sprint-logs/' rule that used to
# live here has been removed -- it blocked the durable *.jsonl/*.analysis.md/
# calibration.json artifacts documented above (**/sprint-logs/sprint_*.json)
# from ever being staged (a directory-level ignore shadows everything inside
# it, including files an unrelated pattern elsewhere tries to un-ignore), so
# every new sprint-cost log needed a manual 'git add -f' despite the sprint
# workflow's own docs saying to just commit it. The scoped
# '**/sprint-logs/sprint_*.json' rule above is what actually needs ignoring
# (bin/cli.mjs's per-run state snapshot) and covers this on its own.

# Per-member installed agent role files -- must stay on disk, never committed
.claude/agents/
packages/apra-fleet-se/auto-sprint/logs/
