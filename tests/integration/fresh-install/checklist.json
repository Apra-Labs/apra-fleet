{
  "_comment": "One checklist for every platform (windows, linux, macos). box/pass.ps1 and box/pass.sh record one JSON line per step id; lib/verdict.mjs applies these expectations. ${expectVersion}/${baselineVersion} come from run.mjs. envLimited = failure explained by a documented environment limit (no systemd in the Linux container); an envLimited rule with `drivers` applies only under those drivers, so the host driver on a real VM never excuses a missing service.",
  "passes": {
    "A": {
      "title": "Fresh install, no Node.js on PATH",
      "steps": [
        { "id": "A01", "title": "candidate --version", "expect": { "exit": 0, "observed": "^${expectVersion}$" } },
        { "id": "A02", "title": "precondition: node not on PATH", "expect": { "exit": "nonzero" } },
        { "id": "A03", "title": "default install refuses, names fleet-se prerequisite", "expect": { "exit": "nonzero", "keyline": "fleet-se requires Node\\.js 22\\.16\\+ and npm" } },
        { "id": "A04", "title": "nothing written by refused install", "expect": { "exit": 0 } },
        { "id": "A05", "title": "install --workflows none", "expect": { "exit": 0, "keyline": "installed successfully" },
          "envLimited": [ { "platforms": ["linux"], "drivers": ["docker"], "keyline": "systemd", "note": "no systemd user manager in the container" } ] },
        { "id": "A06", "title": "server service registered and running", "expect": { "exit": 0, "keyline": "Running|active" } },
        { "id": "A07", "title": "GET /health 200 on candidate version", "expect": { "exit": 200, "observed": "^${expectVersion}$" } },
        { "id": "A08", "title": "GET /ui serves the shell", "severity": "advisory", "expect": { "exit": 200, "keyline": "id=\"root\"" }, "na": { "exit": [404], "reason": "this build does not serve /ui" } },
        { "id": "A09", "title": "GET /api/fleet/members without credential is 401", "expect": { "exit": 401 }, "na": { "exit": [404], "reason": "route not served by this build" } },
        { "id": "A10", "title": "apra-fleet status", "expect": { "exit": 0, "keyline": "running" } }
      ]
    },
    "B": {
      "title": "Fresh install with pinned Node.js LTS",
      "steps": [
        { "id": "B01", "title": "candidate --version", "expect": { "exit": 0, "observed": "^${expectVersion}$" } },
        { "id": "B02", "title": "install pinned Node.js (checksum verified)", "expect": { "exit": 0, "observed": "^v22\\.(1[6-9]|[2-9][0-9])\\." } },
        { "id": "B03", "title": "npm available", "expect": { "exit": 0 } },
        { "id": "B04", "title": "default install", "expect": { "exit": 0, "keyline": "installed successfully" },
          "envLimited": [ { "platforms": ["linux"], "drivers": ["docker"], "keyline": "systemd", "note": "no systemd user manager in the container" } ] },
        { "id": "B05", "title": "bd 1.3.0 installed", "expect": { "exit": 0, "keyline": "1\\.3\\.0" } },
        { "id": "B06", "title": "server service registered and running", "expect": { "exit": 0, "keyline": "Running|active" } },
        { "id": "B07", "title": "supervisor service (if this build installs one)", "expect": { "exit": 0, "keyline": "Running|active" } },
        { "id": "B08", "title": "GET /health 200 on candidate version", "expect": { "exit": 200, "observed": "^${expectVersion}$" } },
        { "id": "B09", "title": "MCP initialize over HTTP", "expect": { "exit": 200, "keyline": "serverInfo" } },
        { "id": "B10", "title": "MCP with invalid bearer is 401", "expect": { "exit": 401 } },
        { "id": "B11", "title": "POST /shutdown without bearer is 401", "expect": { "exit": 401 } },
        { "id": "B12", "title": "GET /api/fleet/members without credential is 401", "expect": { "exit": 401 }, "na": { "exit": [404], "reason": "route not served by this build" } },
        { "id": "B13", "title": "GET /ui serves the shell", "severity": "advisory", "expect": { "exit": 200, "keyline": "id=\"root\"" }, "na": { "exit": [404], "reason": "this build does not serve /ui" } },
        { "id": "B14", "title": "apra-fleet status (server still up)", "expect": { "exit": 0, "keyline": "running" } }
      ]
    },
    "U": {
      "title": "Upgrade baseline -> candidate via install --force (Node present)",
      "steps": [
        { "id": "U01", "title": "install pinned Node.js (checksum verified)", "expect": { "exit": 0, "observed": "^v22\\." } },
        { "id": "U02", "title": "baseline --version", "expect": { "exit": 0, "observed": "^${baselineVersion}$" } },
        { "id": "U03", "title": "baseline install", "expect": { "exit": 0, "keyline": "installed successfully" },
          "envLimited": [ { "platforms": ["linux"], "drivers": ["docker"], "keyline": "systemd", "note": "no systemd user manager in the container" } ] },
        { "id": "U04", "title": "baseline server up on baseline version", "expect": { "exit": 200, "observed": "^${baselineVersion}$" } },
        { "id": "U05", "title": "seed dummy member (register-member)", "expect": { "exit": 0 } },
        { "id": "U06", "title": "seed dummy secret (secret --set --persist)", "expect": { "exit": 0 } },
        { "id": "U07", "title": "seed visible before upgrade (member + secret)", "expect": { "exit": 0 } },
        { "id": "U08", "title": "candidate --version", "expect": { "exit": 0, "observed": "^${expectVersion}$" } },
        { "id": "U09", "title": "upgrade: candidate install --force", "expect": { "exit": 0, "keyline": "installed successfully" },
          "envLimited": [ { "platforms": ["linux"], "drivers": ["docker"], "keyline": "systemd|NOT running", "note": "no systemd: --force stopped the hand-started server and could not register a service (loud exit 1 by design)" } ] },
        { "id": "U10", "title": "server back on candidate version", "expect": { "exit": 200, "observed": "^${expectVersion}$" } },
        { "id": "U11", "title": "installed binary is the candidate", "expect": { "exit": 0, "observed": "^${expectVersion}$" } },
        { "id": "U12", "title": "dummy member survived", "expect": { "exit": 0 } },
        { "id": "U13", "title": "dummy secret survived", "expect": { "exit": 0 } },
        { "id": "U14", "title": "fleet.key unchanged", "expect": { "exit": 0 } },
        { "id": "U15", "title": "server service running after upgrade", "expect": { "exit": 0, "keyline": "Running|active" } },
        { "id": "U16", "title": "apra-fleet status after upgrade", "expect": { "exit": 0, "keyline": "running" } },
        { "id": "U17", "title": "apra-fleet update --check (informational)", "severity": "advisory", "expect": { "exit": 0 } },
        { "id": "U18", "title": "task is the NEW form (user-scoped logon, PT5M revive, IgnoreNew, hidden launcher)", "platforms": ["windows"], "expect": { "exit": 0, "keyline": "^logon=\\S*\\\\\\S+ repeat=PT5M policy=IgnoreNew action=(wscript-launcher|bat)$", "observed": "^new form$" } },
        { "id": "U19", "title": "apra-fleet status has no legacy-task hint", "platforms": ["windows"], "expect": { "exit": 0 } },
        { "id": "U20", "title": "exactly one apra-fleet server listening on 7523", "platforms": ["windows"], "expect": { "exit": 0, "keyline": "^listeners=1 .*names=apra-fleet$" } }
      ]
    },
    "U2": {
      "title": "Upgrade a core-only (no Node) install along the apra-fleet update path",
      "_comment": "Since v0.4.3 a no-Node user can only hold a core-only install (--workflows none); the default install refuses without Node. This pass upgrades that user: the default installer still refuses and leaves the baseline running, and the update argv (install-config workflowsMode) upgrades core-only without Node.",
      "steps": [
        { "id": "V01", "title": "baseline --version", "expect": { "exit": 0, "observed": "^${baselineVersion}$" } },
        { "id": "V02", "title": "baseline install --workflows none (no Node)", "expect": { "exit": 0, "keyline": "installed successfully" },
          "envLimited": [ { "platforms": ["linux"], "drivers": ["docker"], "keyline": "systemd", "note": "no systemd user manager in the container" } ] },
        { "id": "V03", "title": "baseline server up on baseline version", "expect": { "exit": 200, "observed": "^${baselineVersion}$" } },
        { "id": "V04", "title": "seed dummy member + secret", "expect": { "exit": 0 } },
        { "id": "V05", "title": "baseline apra-fleet update (targets GitHub latest; cannot target a local binary)", "severity": "advisory", "expect": { "exit": 0 } },
        { "id": "V06", "title": "candidate default install --force, no Node: refused naming prerequisite", "severity": "advisory", "expect": { "exit": "nonzero", "keyline": "fleet-se requires Node\\.js 22\\.16\\+ and npm" } },
        { "id": "V07", "title": "refused install left baseline server running", "expect": { "exit": 200, "observed": "^${baselineVersion}$" } },
        { "id": "V08", "title": "update argv replayed with candidate, no Node: core-only upgrade succeeds", "expect": { "exit": 0, "keyline": "installed successfully", "observed": "^--workflows none$" },
          "envLimited": [ { "platforms": ["linux"], "drivers": ["docker"], "keyline": "systemd|NOT running", "observed": "^--workflows none$", "note": "no systemd: --force stopped the hand-started server and could not register a service (loud exit 1 by design)" } ] },
        { "id": "V09", "title": "server back on candidate version", "expect": { "exit": 200, "observed": "^${expectVersion}$" } },
        { "id": "V10", "title": "dummy member + secret survived", "expect": { "exit": 0 } },
        { "id": "V11", "title": "server service running after upgrade", "expect": { "exit": 0, "keyline": "Running|active" } },
        { "id": "V12", "title": "apra-fleet status after upgrade", "expect": { "exit": 0, "keyline": "running" } },
        { "id": "V13", "title": "task is the NEW form (user-scoped logon, PT5M revive, IgnoreNew, hidden launcher)", "platforms": ["windows"], "expect": { "exit": 0, "keyline": "^logon=\\S*\\\\\\S+ repeat=PT5M policy=IgnoreNew action=(wscript-launcher|bat)$", "observed": "^new form$" } },
        { "id": "V14", "title": "apra-fleet status has no legacy-task hint", "platforms": ["windows"], "expect": { "exit": 0 } },
        { "id": "V15", "title": "exactly one apra-fleet server listening on 7523", "platforms": ["windows"], "expect": { "exit": 0, "keyline": "^listeners=1 .*names=apra-fleet$" } }
      ]
    },
    "UL": {
      "title": "Windows: the baseline's elevated legacy task, upgraded from a normal (non-elevated) shell",
      "_comment": "The baseline (0.4.3) registered the task with schtasks /sc onlogon, which needs admin. The same user's non-elevated token (built like UAC's: a LUA-restricted copy of the runner token, Administrators deny-only, lowered to Medium integrity; no console, no TTY) can neither replace nor disable it: install must reuse it, explain the fix (notice file, fleet.log, status) without attempting elevation, and the documented fix (elevated delete, then a non-elevated install --force) must yield the new task, which runs the candidate.",
      "steps": [
        { "id": "L00", "title": "probe: UAC policy and integrity level (informational)", "platforms": ["windows"], "severity": "advisory", "expect": { "exit": 0 } },
        { "id": "L01", "title": "non-elevated context of the same user runs at medium integrity", "platforms": ["windows"], "expect": { "exit": 0, "keyline": "Medium Mandatory Level" } },
        { "id": "L02", "title": "baseline --version", "platforms": ["windows"], "expect": { "exit": 0, "observed": "^${baselineVersion}$" } },
        { "id": "L03", "title": "baseline install from the elevated runner (registers the legacy task)", "platforms": ["windows"], "expect": { "exit": 0, "keyline": "installed successfully" } },
        { "id": "L04", "title": "the baseline registered the legacy onlogon task", "platforms": ["windows"], "expect": { "exit": 0, "keyline": "^logon=ANY-USER repeat=none .*action=bat$" } },
        { "id": "L05", "title": "baseline server up through the legacy task", "platforms": ["windows"], "expect": { "exit": 200, "observed": "^${baselineVersion}$" } },
        { "id": "L06", "title": "candidate install --force as the standard user", "platforms": ["windows"], "expect": { "exit": 0, "keyline": "installed successfully" } },
        { "id": "L07", "title": "legacy task reused (create denied) with guidance", "platforms": ["windows"], "expect": { "exit": 0 } },
        { "id": "L08", "title": "no elevation attempted (non-interactive)", "platforms": ["windows"], "expect": { "exit": 0 } },
        { "id": "L09", "title": "legacy task left in place", "platforms": ["windows"], "expect": { "exit": 0 } },
        { "id": "L10", "title": "guidance persisted to service-notice.json", "platforms": ["windows"], "expect": { "exit": 0 } },
        { "id": "L11", "title": "guidance appended to fleet.log", "platforms": ["windows"], "expect": { "exit": 0 } },
        { "id": "L12", "title": "server back on the candidate through the old task", "platforms": ["windows"], "expect": { "exit": 200, "observed": "^${expectVersion}$" } },
        { "id": "L13", "title": "apra-fleet status shows legacy task (upgrade needed: ...) + fix", "platforms": ["windows"], "expect": { "exit": 0 } },
        { "id": "L14", "title": "documented fix 1/2: elevated schtasks /delete", "platforms": ["windows"], "expect": { "exit": 0 } },
        { "id": "L15", "title": "documented fix 2/2: install --force, not elevated", "platforms": ["windows"], "expect": { "exit": 0, "keyline": "installed successfully" } },
        { "id": "L14b", "title": "runner artifact: stop the High-integrity legacy server elevated (a real user's runs at Medium)", "platforms": ["windows"], "severity": "advisory", "expect": { "exit": 0 } },
        { "id": "L16", "title": "task is now the NEW form, scoped to the user", "platforms": ["windows"], "expect": { "exit": 0, "keyline": "^logon=\\S*\\\\\\S+ repeat=PT5M policy=IgnoreNew action=(wscript-launcher|bat)$", "observed": "^new form$" } },
        { "id": "L17", "title": "service-notice.json cleared", "platforms": ["windows"], "expect": { "exit": 0 } },
        { "id": "L18", "title": "apra-fleet status has no legacy-task hint after the fix", "platforms": ["windows"], "expect": { "exit": 0 } },
        { "id": "L19", "title": "server up on the candidate through the new (non-elevated) task", "platforms": ["windows"], "expect": { "exit": 200, "observed": "^${expectVersion}$" } },
        { "id": "L20", "title": "exactly one apra-fleet server listening on 7523", "platforms": ["windows"], "expect": { "exit": 0, "keyline": "^listeners=1 .*names=apra-fleet$" } }
      ]
    }
  }
}
