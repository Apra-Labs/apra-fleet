{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Apra-Labs/apra-fleet/blob/main/memory-contract/v1/schemas/kb_bible_commit.response.json#",
  "x-invariant": [
    "INV-09"
  ],
  "$ref": "#/$defs/v1-kb_bible_commit-response",
  "$defs": {
    "v1-kb_bible_commit-response": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "text"
              },
              "text": {
                "type": "string"
              },
              "annotations": {
                "type": "object",
                "properties": {
                  "audience": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "user",
                        "assistant"
                      ]
                    }
                  },
                  "priority": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 3
        },
        "structuredContent": {
          "type": "object",
          "additionalProperties": {}
        },
        "parsed": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "merged": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "demoted": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "skipped": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "not_confirmed_or_unknown",
                      "no_source_files",
                      "basis_mismatch",
                      "not_demoted_or_unknown"
                    ]
                  }
                },
                "required": [
                  "id",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "superseded",
                      "invalidated"
                    ]
                  }
                },
                "required": [
                  "id",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "entry_count": {
              "type": "number"
            },
            "committed": {
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "merged",
            "skipped",
            "removed",
            "entry_count",
            "committed"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    }
  }
}
