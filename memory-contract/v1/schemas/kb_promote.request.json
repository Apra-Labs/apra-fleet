{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Apra-Labs/apra-fleet/blob/main/memory-contract/v1/schemas/kb_promote.request.json#",
  "x-invariant": [
    "INV-05"
  ],
  "$ref": "#/$defs/v1-kb_promote-request",
  "$defs": {
    "v1-kb_promote-request": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "ID of the KB entry to promote"
        },
        "reason": {
          "type": "string",
          "description": "Reason for promotion (appended to content as evidence trail)"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  }
}
