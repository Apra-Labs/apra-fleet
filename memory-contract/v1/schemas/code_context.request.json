{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Apra-Labs/apra-fleet/blob/main/memory-contract/v1/schemas/code_context.request.json#",
  "$ref": "#/$defs/v1-code_context-request",
  "$defs": {
    "v1-code_context-request": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Symbol name to retrieve callers, callees, and execution flows for, e.g. \"validateUser\""
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  }
}
