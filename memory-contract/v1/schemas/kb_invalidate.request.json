{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Apra-Labs/apra-fleet/blob/main/memory-contract/v1/schemas/kb_invalidate.request.json#",
  "x-invariant": [
    "INV-05"
  ],
  "$ref": "#/$defs/v1-kb_invalidate-request",
  "$defs": {
    "v1-kb_invalidate-request": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "File paths to invalidate (context-cache entries for these files will be marked stale)"
        }
      },
      "required": [
        "files"
      ],
      "additionalProperties": false
    }
  }
}
