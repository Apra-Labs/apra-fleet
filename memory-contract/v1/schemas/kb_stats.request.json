{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Apra-Labs/apra-fleet/blob/main/memory-contract/v1/schemas/kb_stats.request.json#",
  "x-invariant": [
    "INV-05"
  ],
  "$ref": "#/$defs/v1-kb_stats-request",
  "$defs": {
    "v1-kb_stats-request": {
      "type": "object",
      "properties": {
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Symbols to check coverage for: per-symbol boolean (a live CONFIRMED entry whose symbols array contains it, exact match) plus the overall fraction."
        }
      },
      "additionalProperties": false
    }
  }
}
