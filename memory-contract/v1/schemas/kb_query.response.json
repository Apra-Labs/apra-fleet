{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Apra-Labs/apra-fleet/blob/main/memory-contract/v1/schemas/kb_query.response.json#",
  "x-invariant": [
    "INV-09",
    "INV-08"
  ],
  "$ref": "#/$defs/v1-kb_query-response",
  "$defs": {
    "v1-kb_query-response": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "text"
              },
              "text": {
                "type": "string"
              },
              "annotations": {
                "type": "object",
                "properties": {
                  "audience": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "user",
                        "assistant"
                      ]
                    }
                  },
                  "priority": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 3
        },
        "structuredContent": {
          "type": "object",
          "additionalProperties": {}
        },
        "parsed": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "l1_results": {
                  "type": "array",
                  "items": {}
                },
                "l2_expanded": {
                  "type": "array",
                  "items": {}
                },
                "related_claims": {
                  "type": "array",
                  "items": {}
                }
              },
              "required": [
                "l1_results",
                "l2_expanded"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "flagged_entries": {
                  "type": "array",
                  "items": {}
                },
                "total": {
                  "type": "number"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "flagged_entries",
                "total",
                "note"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    }
  }
}
