{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Apra-Labs/apra-fleet/blob/main/memory-contract/v1/schemas/kb_context.request.json#",
  "x-invariant": [
    "INV-05"
  ],
  "$ref": "#/$defs/v1-kb_context-request",
  "$defs": {
    "v1-kb_context-request": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "INFERRED",
              "UNVERIFIED"
            ]
          },
          "minItems": 1,
          "description": "Only consider cached file entries whose confidence tier is in this list. Default when omitted: [\"CONFIRMED\"] -- INFERRED and UNVERIFIED entries are considered only when listed explicitly."
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "File paths to check freshness for"
        }
      },
      "required": [
        "files"
      ],
      "additionalProperties": false
    }
  }
}
