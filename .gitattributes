# Normalise all text files to LF in the repository.
# Git converts to native line endings on checkout (Windows gets CRLF locally)
# but the canonical stored form is always LF.
* text=auto eol=lf

# Binary files - no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
*.exe binary
*.node binary

# Knowledge bible: merged by entry id through the apra-fleet merge driver that
# kb_setup registers in a clone (git config merge.apra-fleet-kb-bible.driver).
# A clone without it falls back to git's line merge.
.fleet/kb-canonical.json merge=apra-fleet-kb-bible
