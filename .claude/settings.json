{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(apra-fleet* --version)",
      "Bash(apra-fleet* run *)",
      "Bash(node scripts/preflight-clear-build-locks.mjs)",
      "Bash(npm ci)",
      "Bash(npm run build)",
      "Bash(npm run build:binary)",
      "Bash(dist/apra-fleet-installer-* install *)",
      "Bash(curl * localhost:8787/api/sprints*)"
    ]
  }
}
